    {
      "id": "valid_is_empty_empty_list_and_object",
      "description": "is_empty returns true for empty list [] and empty object {}",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "group",
          "operator": "and",
          "children": [
            {
              "type": "comparison",
              "operator": "is_empty",
              "left": {
                "mode": "variable",
                "path": { "scope": "doc", "segments": ["items"] }
              }
            },
            {
              "type": "comparison",
              "operator": "is_empty",
              "left": {
                "mode": "variable",
                "path": { "scope": "doc", "segments": ["custom_json"] }
              }
            }
          ]
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": {
            "items": [],
            "custom_json": {}
          }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_short_circuit_and_evaluation",
      "description": "Group AND short-circuits on first false condition without evaluating subsequent errored condition",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "group",
          "operator": "and",
          "children": [
            {
              "type": "comparison",
              "operator": "equals",
              "left": {
                "mode": "variable",
                "path": { "scope": "doc", "segments": ["status"] }
              },
              "right": {
                "mode": "static",
                "value_type": "string",
                "value": "Submitted"
              }
            },
            {
              "type": "comparison",
              "operator": "greater_than",
              "left": {
                "mode": "variable",
                "path": { "scope": "doc", "segments": ["missing_field"] }
              },
              "right": {
                "mode": "static",
                "value_type": "integer",
                "value": 10
              }
            }
          ]
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": { "status": "Draft" }
        },
        "expected_outcome": false,
        "expected_diagnostic_code": null
      }
    },
    {
