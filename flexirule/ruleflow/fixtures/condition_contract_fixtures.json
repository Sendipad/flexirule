{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlexiRule Canonical Condition Contract Test Fixtures",
  "version": 1,
  "fixtures": [
    {
      "id": "valid_basic_typed_comparison_equals",
      "description": "Valid basic string equality comparison with canonical envelope and business operator 'equals'",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "comparison",
          "operator": "equals",
          "left": {
            "mode": "variable",
            "path": { "scope": "doc", "segments": ["status"] }
          },
          "right": {
            "mode": "static",
            "value_type": "string",
            "value": "Submitted"
          }
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": { "status": "Submitted" }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_basic_typed_comparison_greater_than",
      "description": "Valid numeric greater_than comparison between decimal variable and numeric static value",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "comparison",
          "operator": "greater_than",
          "left": {
            "mode": "variable",
            "path": { "scope": "doc", "segments": ["grand_total"] }
          },
          "right": {
            "mode": "static",
            "value_type": "integer",
            "value": 1000
          }
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": { "grand_total": 500.00 }
        },
        "expected_outcome": false,
        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_nested_and_or_groups",
      "description": "Valid nested AND/OR group structure demonstrating explicit logic without precedence ambiguity",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "group",
          "operator": "and",
          "children": [
            {
              "type": "comparison",
              "operator": "equals",
              "left": {
                "mode": "variable",
                "path": { "scope": "doc", "segments": ["docstatus"] }
              },
              "right": {
                "mode": "static",
                "value_type": "integer",
                "value": 1
              }
            },
            {
              "type": "group",
              "operator": "or",
              "children": [
                {
                  "type": "comparison",
                  "operator": "greater_than",
                  "left": {
                    "mode": "variable",
                    "path": { "scope": "doc", "segments": ["grand_total"] }
                  },
                  "right": {
                    "mode": "static",
                    "value_type": "integer",
                    "value": 5000
                  }
                },
                {
                  "type": "comparison",
                  "operator": "equals",
                  "left": {
                    "mode": "variable",
                    "path": { "scope": "doc", "segments": ["customer_group"] }
                  },
                  "right": {
                    "mode": "static",
                    "value_type": "string",
                    "value": "VIP"
                  }
                }
              ]
            }
          ]
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": {
            "docstatus": 1,
            "grand_total": 2000,
            "customer_group": "VIP"
          }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_typed_document_reference",
      "description": "Valid explicitly typed document reference in FlexValue right operand",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "comparison",
          "operator": "equals",
          "left": {
            "mode": "variable",
            "path": { "scope": "doc", "segments": ["customer"] }
          },
          "right": {
            "mode": "static",
            "value_type": "document_reference",
            "value": {
              "doctype": "Customer",
              "name": "CUST-0001"
            }
          }
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": { "customer": "CUST-0001" }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_ordinary_two_item_list",
      "description": "Valid ordinary two-item list comparison (is_one_of) that must remain a list and not be inferred as a Link tuple",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "comparison",
          "operator": "is_one_of",
          "left": {
            "mode": "variable",
            "path": { "scope": "doc", "segments": ["status"] }
          },
          "right": {
            "mode": "static",
            "value_type": "list",
            "value": ["Customer", "CUST-0001"]
          }
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": { "status": "Customer" }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
