        "expected_diagnostic_code": null
      }
    },
    {
      "id": "valid_collection_predicate_any",
      "description": "Valid collection predicate checking if any child row satisfies the where condition",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "collection_predicate",
          "quantifier": "any",
          "source": {
            "mode": "variable",
            "path": { "scope": "doc", "segments": ["items"] }
          },
          "as": "item_row",
          "where": {
            "type": "comparison",
            "operator": "greater_than",
            "left": {
              "mode": "variable",
              "path": { "scope": "item_row", "segments": ["amount"] }
            },
            "right": {
              "mode": "static",
              "value_type": "integer",
              "value": 500
            }
          }
        }
      },
      "expected_status": "accept",
      "expected_diagnostic_code": null,
      "evaluation": {
        "context": {
          "doc": {
            "items": [
              { "item_code": "A", "amount": 100 },
              { "item_code": "B", "amount": 750 }
            ]
          }
        },
        "expected_outcome": true,
        "expected_diagnostic_code": null
      }
    },
    {
