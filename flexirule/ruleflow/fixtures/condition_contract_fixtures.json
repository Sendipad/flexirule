    {
      "id": "valid_false_versus_zero_no_coercion",
      "description": "Valid comparison asserting boolean false is distinct from numeric zero",
      "payload": {
        "schema": "flexirule.condition",
        "version": 1,
        "root": {
          "type": "comparison",
          "operator": "equals",
          "left": {
            "mode": "variable",
            "path": { "scope": "vars", "segments": ["is_active"] }
          },
          "right": {
            "mode": "static",
            "value_type": "integer",
            "value": 0
          }
        }
      },
      "expected_status": "accept",
